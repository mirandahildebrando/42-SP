# Ambiente interativo da Piscina 42SP (Git Bash)
# Carregado por ABRIR-42.cmd. Não é necessário editar este arquivo.

SP42="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
export SP42
export PATH="$SP42/tools/mingw64/bin:$SP42/tools/shell/bin:$SP42/tools/win:$PATH"
export PYTHONUTF8=1
export PYTHONIOENCODING=utf-8
export LC_ALL=C.UTF-8
export LANG=C.UTF-8

if command -v cygpath >/dev/null 2>&1; then
    PY="$(cygpath "$LOCALAPPDATA")/Programs/Python/Python312/python.exe"
else
    PY="$LOCALAPPDATA/Programs/Python/Python312/python.exe"
fi
if [ ! -x "$PY" ]; then
    PY="$(command -v python3 || command -v python)"
fi
export PY

moulinette() { "$PY" "$SP42/tools/moulinette/moulinette.py" "$@"; }
norminette() { "$PY" -m norminette --no-colors -R CheckForbiddenSourceHeader "$@"; }
42header() { "$PY" "$SP42/tools/header.py" "$@"; }
exame() { "$PY" "$SP42/tools/exame/exame.py" "$@"; }
make() { mingw32-make "$@"; }

# atalhos de navegação
piscina() { cd "$SP42/piscina" || return; }
raiz() { cd "$SP42" || return; }

cd "$SP42" || return

PS1='\[\e[1;36m\]42SP\[\e[0m\]:\[\e[1;33m\]\w\[\e[0m\]$ '
printf '\033[1;36m'
printf '  Piscina 42SP — ambiente de treino\033[0m\n'
LOGIN42="$(sed -n 's/^[[:space:]]*login[[:space:]]*=[[:space:]]*//p' "$SP42/42.config" 2>/dev/null | head -1)"
printf '  Login: %s  |  GCC: %s\n' "${LOGIN42:-hilde}" "$(gcc --version 2>/dev/null | head -1)"
printf '  Comandos: moulinette | norminette | 42header | exame | make\n'
printf '  Comece com: cd piscina/C00/ex00  e leia ENUNCIADO.md\n\n'
